
/* Float modes.  */
FLOAT_MODE (HF, 2, ieee_half_format);        /* Half-precision floating point */

/* Vector modes.  */
VECTOR_MODES (INT, 4);        /* V4QI   V2HI             */
VECTOR_MODES (INT, 8);        /* V8QI   V4HI V2SI        */
VECTOR_MODES (INT, 16);       /* V16QI  V8HI V4SI V2DI */

VECTOR_MODES (FRACT, 4);      /* V4QQ   V2HQ */
VECTOR_MODES (FRACT, 8);      /* V8QQ   V4HQ V2SQ */
VECTOR_MODES (FRACT, 16);     /* V16QQ  V8HQ V4SQ */
VECTOR_MODES (UFRACT, 4);     /* V4UQQ  V2UHQ */
VECTOR_MODES (UFRACT, 8);     /* V8UQQ  V4UHQ V2USQ */
VECTOR_MODES (UFRACT, 16);    /* V16UQQ  V8UHQ V4USQ */

VECTOR_MODES (FLOAT, 16);     /* V8HF V4SF V2DF */

VECTOR_MODE (INT, QI, 1);  /* V1QI */
VECTOR_MODE (INT, QI, 2);  /* V2QI */
VECTOR_MODE (INT, QI, 3);  /* V3QI */

VECTOR_MODE (INT, HI, 1);  /* V1HI */
VECTOR_MODE (INT, HI, 3);  /* V3HI */

VECTOR_MODE (INT, SI, 1);  /* V1SI */
VECTOR_MODE (INT, SI, 3);  /* V3SI */

VECTOR_MODE (FLOAT, HF, 1);  /* V1HF */
VECTOR_MODE (FLOAT, HF, 2);  /* V2HF */
VECTOR_MODE (FLOAT, HF, 3);  /* V3HF */
VECTOR_MODE (FLOAT, HF, 4);  /* V4HF */

VECTOR_MODE (FLOAT, SF, 1);  /* V1SF */
VECTOR_MODE (FLOAT, SF, 2);  /* V2SF */
VECTOR_MODE (FLOAT, SF, 3);  /* V3SF */

/* Opaque integer modes */
INT_MODE (OI, 32);
INT_MODE (CI, 48);
INT_MODE (XI, 64);
